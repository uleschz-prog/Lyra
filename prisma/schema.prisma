generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum PackageType {
  NONE
  FREE
  STARTED
  PRO
  FOUNDER
  CORPORATE
  VEGA
  POLARIS
  LYRA_MASTER
}

enum Rank {
  ASTRA
  NOVA
  ALPHA
  PULSAR
  VEGA
  CONSTELLATION
}

enum TransactionKind {
  COMMISSION
  CREDIT_PURCHASE
  CREDIT_SPEND
  ADJUSTMENT
  REBUY
  CREDIT_REFUND
}

/// Cierre de la red: cada fila une a un afiliado con un ancestro y la distancia entre ambos.
model NetworkRelation {
  id         String @id @default(cuid())
  userId     String
  ancestorId String
  depth      Int

  user     User @relation("DescendantLinks", fields: [userId], references: [id], onDelete: Cascade)
  ancestor User @relation("AncestorLinks", fields: [ancestorId], references: [id], onDelete: Cascade)

  @@unique([userId, ancestorId])
  @@index([ancestorId, depth])
  @@index([userId, depth])
}

model User {
  id                   String      @id @default(uuid())
  name                 String
  email                String      @unique
  username             String      @unique
  password             String
  role                 Role        @default(MEMBER)
  package              PackageType @default(NONE)
  pendingPackage       PackageType?
  rank                 Rank        @default(ASTRA)
  sponsorId            String?
  referralCode         String      @unique
  credits              Int         @default(0)
  walletBalance        Float       @default(0)
  isSubscriptionExempt Boolean     @default(false)
  activationCredits    Int         @default(0)
  activatedWithCode    Boolean     @default(false)
  suspendedUntil       DateTime?
  alphaFastTrackUntil  DateTime?
  avatar               String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  sponsor   User?  @relation("Sponsorship", fields: [sponsorId], references: [id], onDelete: SetNull)
  referrals User[] @relation("Sponsorship")

  descendantLinks NetworkRelation[] @relation("DescendantLinks")
  ancestorLinks   NetworkRelation[] @relation("AncestorLinks")

  wallet          CreditWallet?
  transactions    Transaction[]
  projects        Project[]
  creations       CreationPiece[]
  activationCodes ActivationCode[] @relation("ActivationOwner")
  activation      ActivationCode?  @relation("ActivationUsedBy")

  @@index([sponsorId])
  @@index([rank])
}

/// Código prepagado con créditos de activación. La cuenta que lo usa no genera puntos.
model ActivationCode {
  id        String      @id @default(cuid())
  code      String      @unique
  packageId PackageType
  price     Int
  ownerId   String
  usedById  String?     @unique
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  owner  User  @relation("ActivationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  usedBy User? @relation("ActivationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

model CreationPiece {
  id        String   @id @default(cuid())
  userId    String
  area      String
  kind      String
  title     String
  body      String   @db.Text
  media     String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, area, createdAt])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  idea      String
  kind      String   @default("app")
  published Boolean  @default(false)
  ui        Json?
  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tables ProjectTable[]
  agents ProjectAgent[]
  flows  ProjectFlow[]
  runs   ProjectRun[]

  @@index([userId, createdAt])
}

/// Catálogo de las tablas creadas para un proyecto. Las filas viven en el esquema projects.
model ProjectTable {
  id        String   @id @default(cuid())
  projectId String
  name      String
  physical  String   @unique
  columns   String[]
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model ProjectAgent {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  instruction String
  status      String   @default("running")
  createdAt   DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    ProjectRun[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ProjectFlow {
  id        String   @id @default(cuid())
  projectId String
  name      String
  tableName String
  agentName String
  status    String   @default("running")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, tableName])
}

model ProjectRun {
  id        String   @id @default(cuid())
  projectId String
  agentId   String
  agentName String
  flowName  String
  input     String
  output    String
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent   ProjectAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Course {
  id              String   @id @default(cuid())
  title           String
  description     String
  videoUrl        String?
  rankRequirement Rank     @default(ASTRA)
  createdAt       DateTime @default(now())
  lessons         Lesson[]
}

model Lesson {
  id              String @id @default(cuid())
  courseId        String
  title           String
  description     String
  videoUrl        String
  rankRequirement Rank   @default(ASTRA)
  position        Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
}

model AIAgent {
  id             String @id @default(cuid())
  name           String
  description    String
  category       String
  promptTemplate String
  creditCost     Int

  @@index([category])
}

model CreditWallet {
  id                     String        @id @default(cuid())
  userId                 String        @unique
  balance                Int           @default(0)
  totalEarnedCommissions Decimal       @default(0) @db.Decimal(12, 2)
  updatedAt              DateTime      @updatedAt
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  walletId    String
  amount      Decimal         @default(0) @db.Decimal(12, 2)
  creditDelta Int             @default(0)
  kind        TransactionKind
  description String
  /// Clave de idempotencia. Un reintento con la misma clave no vuelve a mover el saldo.
  externalRef String?         @unique
  /// Motivo estable del movimiento (`ai.agent`, `ai.search`, `admin.adjust`, `vega.action`…).
  reason      String?
  /// Datos del cobro para fases posteriores (bolsa de acciones Vega, límites diarios).
  metadata    Json?
  createdAt   DateTime        @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
}
