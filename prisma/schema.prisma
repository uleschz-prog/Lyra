generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum PackageType {
  NONE
  FREE
  STARTED
  PRO
  FOUNDER
  CORPORATE
  VEGA
  POLARIS
  LYRA_MASTER
  VEGA_PARTNER
}

enum Rank {
  ASTRA
  NOVA
  ALPHA
  PULSAR
  VEGA
  CONSTELLATION
}

enum TransactionKind {
  COMMISSION
  CREDIT_PURCHASE
  CREDIT_SPEND
  ADJUSTMENT
  REBUY
  PAYOUT
  USDT_ORDER
}

enum AcademyCourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AcademyPricingType {
  FREE
  ONE_TIME
  MONTHLY
}

enum AcademyEnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AcademyPaymentStatus {
  CREATED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

/// Parámetros de configuración global de la app (p. ej. wallet USDT de la empresa).
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Orden de pago por USDT (TRC20) que un socio declara haber transferido y queda pendiente de validación.
model UsdtOrder {
  id            String    @id @default(cuid())
  userId        String
  purpose       String // signup | rebuy | credits
  amountUsd     Decimal   @db.Decimal(12, 2)
  trxHash       String?   @unique
  companyWallet String
  status        String    @default("pending") // pending | approved | rejected
  note          String?   @db.Text
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

/// Cierre de la red: cada fila une a un afiliado con un ancestro y la distancia entre ambos.
model NetworkRelation {
  id         String @id @default(cuid())
  userId     String
  ancestorId String
  depth      Int

  user     User @relation("DescendantLinks", fields: [userId], references: [id], onDelete: Cascade)
  ancestor User @relation("AncestorLinks", fields: [ancestorId], references: [id], onDelete: Cascade)

  @@unique([userId, ancestorId])
  @@index([ancestorId, depth])
  @@index([userId, depth])
}

model User {
  id                   String       @id @default(uuid())
  name                 String
  email                String       @unique
  username             String       @unique
  password             String
  role                 Role         @default(MEMBER)
  package              PackageType  @default(NONE)
  pendingPackage       PackageType?
  rank                 Rank         @default(ASTRA)
  sponsorId            String?
  referralCode         String       @unique
  credits              Int          @default(0)
  videoQuotaSeconds    Int          @default(0)
  videoQuotaExpiresAt  DateTime?
  videoQuotaCycleId    String?
  walletBalance        Float        @default(0)
  isSubscriptionExempt Boolean      @default(false)
  activationCredits    Int          @default(0)
  activatedWithCode    Boolean      @default(false)
  suspendedUntil       DateTime?
  alphaFastTrackUntil  DateTime?
  avatar               String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  sponsor   User?  @relation("Sponsorship", fields: [sponsorId], references: [id], onDelete: SetNull)
  referrals User[] @relation("Sponsorship")

  descendantLinks NetworkRelation[] @relation("DescendantLinks")
  ancestorLinks   NetworkRelation[] @relation("AncestorLinks")

  wallet             CreditWallet?
  transactions       Transaction[]
  mediaPieces        MediaPiece[]
  videoGenerations   VideoGeneration[]
  whatsappSchedules  WhatsappScheduledMessage[]
  vegaChats          VegaConversation[]
  vegaActions        VegaAction[]
  vegaMemories       VegaMemory[]
  vegaTasks          VegaTask[]
  vegaWhatsappBlocks VegaWhatsappBlock[]
  vegaWhatsapp       String?
  usdtTrc20          String?
  activationCodes    ActivationCode[]    @relation("ActivationOwner")
  activation         ActivationCode?     @relation("ActivationUsedBy")
  vegaProfile        UserProfile?
  vegaAutonomy       VegaAutonomy?
  whatsappConnection WhatsappConnection?
  usdtOrders         UsdtOrder[]
  promoCreated       PromoCode[]         @relation("PromoOwner")
  promoUses          PromoCodeUse[]      @relation("PromoUser")
  creatorAccount     CreatorAccount?
  academyCourses     Course[]             @relation("CourseCreator")
  courseEnrollments  CourseEnrollment[]   @relation("EnrollmentStudent")
  academyPurchases   AcademyTransaction[] @relation("AcademyBuyer")
  academySales       AcademyTransaction[] @relation("AcademyCreator")
  lessonComments     LessonComment[]
  academyOAuthStates AcademyOAuthState[]

  @@index([sponsorId])
  @@index([rank])
}

/// Perfil estructurado del socio; Vega lo carga siempre como contexto.
model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  business  String?  @db.Text // Qué vende o hace el socio.
  goals     String?  @db.Text // Metas de ventas, red o negocio.
  tone      String?  @db.Text // Tono preferido en los mensajes.
  markets   String?  @db.Text // Mercados o nichos.
  services  String?  @db.Text // Productos o servicios.
  hours     String?  @db.Text // Horarios y disponibilidad.
  team      String?  @db.Text // Personas clave.
  notes     String?  @db.Text // Contexto adicional.
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Permisos de autonomía: qué puede ejecutar Vega sin pedir confirmación.
model VegaAutonomy {
  id         String   @id @default(cuid())
  userId     String   @unique
  enabled    Boolean  @default(false)
  sendEmail  Boolean  @default(false)
  whatsapp   Boolean  @default(false)
  events     Boolean  @default(false)
  appActions Boolean  @default(false)
  dailyLimit Int      @default(5)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// WhatsApp Business (Meta Cloud API) del socio: un número por cuenta.
model WhatsappConnection {
  id            String    @id @default(cuid())
  userId        String    @unique
  phoneNumberId String    @unique
  wabaId        String?
  businessId    String?
  displayPhoneNumber String?
  accessTokenEncrypted String? @db.Text
  tokenExpiresAt DateTime?
  instructions  String    @default("") @db.Text
  ownerPhone    String?   @unique
  status        String    @default("active")
  automation    Boolean   @default(true)
  lastError     String?
  lastWebhookAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats    WhatsappChat[]
  messages WhatsappMessage[]
  scheduledMessages WhatsappScheduledMessage[]
}

/// Estado de un contacto que escribe al WhatsApp Business del socio.
model WhatsappChat {
  id                  String    @id @default(cuid())
  userId              String
  connectionId        String
  phone               String
  name                String?
  stage               String    @default("nuevo")
  intent              String?
  notes               String?   @db.Text
  automation          String    @default("active")
  autoSent            Int       @default(0)
  lastPendingActionId String?
  lastInboundAt       DateTime?
  optedOutAt          DateTime?
  consentAt           DateTime?
  consentSource       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  connection WhatsappConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages   WhatsappMessage[]
  scheduledMessages WhatsappScheduledMessage[]

  @@unique([connectionId, phone])
  @@index([userId, updatedAt])
}

/// Bitácora de mensajes de WhatsApp; waMessageId evita reprocesar duplicados.
model WhatsappMessage {
  id           String   @id @default(cuid())
  userId       String
  connectionId String
  chatRowId    String?
  waMessageId  String?  @unique
  scheduledMessageId String? @unique
  direction    String
  senderType   String
  text         String   @db.Text
  status       String   @default("received")
  error        String?
  createdAt    DateTime @default(now())

  connection WhatsappConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  chat       WhatsappChat?      @relation(fields: [chatRowId], references: [id], onDelete: Cascade)
  scheduledMessage WhatsappScheduledMessage? @relation(fields: [scheduledMessageId], references: [id], onDelete: SetNull)

  @@index([chatRowId, createdAt])
}

/// Mensaje individual con consentimiento registrado y envío diferido.
model WhatsappScheduledMessage {
  id            String   @id @default(cuid())
  userId        String
  connectionId  String
  chatRowId     String
  recipientPhone String
  kind          String   @default("text")
  text          String?  @db.Text
  templateName  String?
  language      String?
  variables     Json?
  consentConfirmed Boolean @default(false)
  runAt         DateTime
  status        String   @default("scheduled")
  error         String?
  waMessageId   String?
  createdAt     DateTime @default(now())
  sentAt        DateTime?
  updatedAt     DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection WhatsappConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  chat       WhatsappChat      @relation(fields: [chatRowId], references: [id], onDelete: Cascade)
  message    WhatsappMessage?

  @@index([status, runAt])
  @@index([userId, status, runAt])
}

/// Código prepagado con créditos de activación. La cuenta que lo usa no genera puntos.
model ActivationCode {
  id        String      @id @default(cuid())
  code      String      @unique
  packageId PackageType
  price     Int
  ownerId   String
  usedById  String?     @unique
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  owner  User  @relation("ActivationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  usedBy User? @relation("ActivationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

/// Código promocional universal del administrador.
/// Cubre cualquier propósito de pago (entrada, recompra, recarga, upgrade)
/// hasta agotar su saldo. Lo genera y usa exclusivamente la cuenta con role ADMIN.
model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  ownerId   String // Siempre la cuenta ADMIN que lo creó.
  budgetUsd Int // Crédito total de este código en USD.
  usedUsd   Int       @default(0) // Cuánto ya se aplicó.
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  owner User           @relation("PromoOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uses  PromoCodeUse[]

  @@index([ownerId])
}

/// Traza de cada uso de un código promocional.
model PromoCodeUse {
  id        String   @id @default(cuid())
  promoId   String
  code      String
  userId    String // Cuenta cuyo pago se salda.
  purpose   String // signup | rebuy | credits | upgrade
  amountUsd Int // Cuánto cubrió este uso.
  createdAt DateTime @default(now())

  promo PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user  User      @relation("PromoUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoId])
  @@index([userId])
}

model VegaConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Nueva conversación")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages VegaMessage[]
  actions  VegaAction[]

  @@index([userId, updatedAt])
}

model VegaMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  meta           Json?
  createdAt      DateTime @default(now())

  conversation VegaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model VegaMemory {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VegaTask {
  id          String    @id @default(cuid())
  userId      String
  title       String
  instruction String    @db.Text
  kind        String    @default("reminder")
  repeat      String    @default("once")
  useWeb      Boolean   @default(false)
  runAt       DateTime
  status      String    @default("active")
  lastRunAt   DateTime?
  lastResult  String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([userId, status])
}

model VegaWhatsappBlock {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
}

model VegaAction {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  kind           String
  payload        Json
  status         String   @default("pending")
  result         String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation VegaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([conversationId])
}

/// Pieza guardada del Notebook o del Estudio creativo: audio, video, PDF o imagen.
model MediaPiece {
  id        String   @id @default(cuid())
  userId    String
  area      String
  kind      String
  title     String
  body      String   @db.Text
  media     String?  @db.Text
  videoGenerationId String? @unique
  createdAt DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoGeneration  VideoGeneration? @relation(fields: [videoGenerationId], references: [id], onDelete: SetNull)

  @@index([userId, area, createdAt])
}

model VideoGeneration {
  id                String   @id @default(cuid())
  userId            String
  activeUserId      String?  @unique
  requestKey        String
  chargeId          String?  @unique
  provider          String   @default("openrouter")
  model             String   @default("x-ai/grok-imagine-video-1.5-lite")
  title             String
  script            String   @db.Text
  format            String
  durationSeconds   Int
  quotaReservedSeconds Int @default(0)
  estimatedCostUsd Float @default(0)
  segmentCount      Int
  segmentDurations  Json     @default("[]")
  completedSegments Int      @default(0)
  segmentJobIds     Json     @default("[]")
  segmentStatusUrls Json     @default("[]")
  segmentVideoUrls  Json     @default("[]")
  currentJobId      String?
  currentStatusUrl  String?
  quotaCycleId      String?
  status            String   @default("starting")
  error             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaPiece MediaPiece?

  @@unique([userId, requestKey])
  @@index([userId, status, createdAt])
}

model Course {
  id              String              @id @default(cuid())
  creatorId       String?
  slug            String?             @unique
  title           String
  description     String              @db.Text
  videoUrl        String?
  coverImageUrl   String?
  price           Decimal             @default(0) @db.Decimal(12, 2)
  currency        String              @default("MXN")
  pricingType     AcademyPricingType  @default(FREE)
  status          AcademyCourseStatus @default(DRAFT)
  publishedAt     DateTime?
  rankRequirement Rank                @default(ASTRA)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  creator      User?                 @relation("CourseCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  modules      CourseModule[]
  lessons      Lesson[]
  enrollments  CourseEnrollment[]
  transactions AcademyTransaction[]

  @@index([creatorId, status, updatedAt])
  @@index([status, publishedAt])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  moduleId        String?
  title           String
  description     String   @db.Text
  content         String?  @db.Text
  videoUrl        String
  durationSeconds Int      @default(0)
  isPreview       Boolean  @default(false)
  isPublished     Boolean  @default(false)
  rankRequirement Rank     @default(ASTRA)
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       CourseModule?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  attachments  LessonAttachment[]
  comments     LessonComment[]
  progressRows LessonProgress[]

  @@index([courseId, position])
  @@index([moduleId, position])
}

model CreatorAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique
  provider             String   @default("mercadopago")
  sellerId             String
  siteId               String?
  accessTokenEncrypted String   @db.Text
  refreshTokenEncrypted String? @db.Text
  tokenExpiresAt       DateTime?
  status               String   @default("connected")
  connectedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions AcademyTransaction[]

  @@index([status])
}

model AcademyOAuthState {
  id                   String    @id @default(cuid())
  userId               String
  stateHash            String    @unique
  codeVerifierEncrypted String   @db.Text
  expiresAt            DateTime
  consumedAt           DateTime?
  createdAt            DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
}

model CourseEnrollment {
  id                   String                  @id @default(cuid())
  courseId             String
  studentId            String
  status               AcademyEnrollmentStatus @default(ACTIVE)
  enrolledAt           DateTime                @default(now())
  expiresAt            DateTime?
  purchaseTransactionId String?                 @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student            User                 @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  purchaseTransaction AcademyTransaction? @relation("EnrollmentPurchase", fields: [purchaseTransactionId], references: [id], onDelete: SetNull)
  progress            LessonProgress[]

  @@unique([courseId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([courseId, status])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

model LessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  fileUrl   String   @db.Text
  mimeType  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
}

model LessonComment {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
}

model AcademyTransaction {
  id                       String                @id @default(cuid())
  courseId                 String
  buyerId                  String
  creatorId                String
  creatorAccountId         String
  externalReference        String                @unique
  gatewayPreferenceId      String?               @unique
  gatewayPaymentId         String?               @unique
  totalAmount              Decimal               @db.Decimal(12, 2)
  lyraFee7Percent          Decimal               @db.Decimal(12, 2)
  creatorPayout93Percent   Decimal               @db.Decimal(12, 2)
  gatewayFee               Decimal?              @db.Decimal(12, 2)
  currency                 String
  feeRate                  Decimal               @default(0.07) @db.Decimal(5, 4)
  paymentGateway           String                @default("mercadopago")
  paymentGatewayStatus     AcademyPaymentStatus @default(CREATED)
  gatewayStatusDetail      String?
  checkoutUrl              String?               @db.Text
  paidAt                   DateTime?
  refundedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  course         Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  buyer          User               @relation("AcademyBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  creator        User               @relation("AcademyCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  creatorAccount CreatorAccount     @relation(fields: [creatorAccountId], references: [id], onDelete: Restrict)
  enrollment     CourseEnrollment?  @relation("EnrollmentPurchase")

  @@index([courseId, paymentGatewayStatus, createdAt])
  @@index([creatorId, paymentGatewayStatus, paidAt])
  @@index([buyerId, paymentGatewayStatus, createdAt])
}

model CreditWallet {
  id                     String        @id @default(cuid())
  userId                 String        @unique
  balance                Int           @default(0)
  totalEarnedCommissions Decimal       @default(0) @db.Decimal(12, 2)
  updatedAt              DateTime      @updatedAt
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  walletId    String
  amount      Decimal         @default(0) @db.Decimal(12, 2)
  creditDelta Int             @default(0)
  kind        TransactionKind
  description String
  externalRef String?         @unique
  createdAt   DateTime        @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
}
