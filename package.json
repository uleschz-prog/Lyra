{
  "name": "lyra-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-schema.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network polygonAmoy",
    "deploy:autonomous": "hardhat run scripts/deploy-lyra-autonomous.ts --network polygonAmoy",
    "deploy:autonomous:local": "hardhat run scripts/deploy-lyra-autonomous.ts --network hardhat",
    "postinstall": "DATABASE_URL=\"${DATABASE_URL:-postgresql://build:build@127.0.0.1:5432/lyra}\" prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "hardhat": "^3.18.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
