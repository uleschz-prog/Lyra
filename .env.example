# PostgreSQL: Vercel Postgres o Supabase (cadena con pooling).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lyra?schema=public"

# Firma de la cookie de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-string-of-32-characters"

# Origen público de los enlaces de referido. Si se omite, se usa el dominio actual.
NEXT_PUBLIC_APP_URL="https://lyyra.vercel.app"

# Modo discusión del builder y notebook. Usa una de las dos claves.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Modelo de video en OpenRouter. Vacío usa x-ai/grok-imagine-video-1.5-lite a 480p.
OPENROUTER_VIDEO_MODEL=""
# Vercel Blob para guardar los videos finales de forma privada.
BLOB_READ_WRITE_TOKEN=""

# Voz del notebook y del estudio creativo. https://elevenlabs.io
ELEVENLABS_API_KEY=""

# Generación de imágenes y videos del estudio. Crea estas credenciales en https://console.higgsfield.ai
HIGGSFIELD_API_KEY_ID=""
HIGGSFIELD_API_KEY_SECRET=""

# Video promocional. Usa una u otra clave según el proveedor del estudio.
HEYGEN_API_KEY=""
RUNWAY_API_KEY=""
# La misma clave, con el nombre que usa Runway. Si las dos existen, gana esta.
RUNWAYML_API_SECRET=""
RUNWAY_DEFAULT_MODEL=""

# Búsqueda de tendencias. https://dashboard.exa.ai
EXA_API_KEY=""

# Registro con Google, GitHub o Apple. Cada una es opcional.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Proyecto Lira en Composio. La clave se crea en Claves API y no se pega en el navegador.
COMPOSIO_API_KEY=""

# Opcional. Si se omite, LYRA usa el primer número de la cuenta de WhatsApp conectada.
WHATSAPP_PHONE_NUMBER_ID=""

# WhatsApp Business Platform (Meta Embedded Signup). El app ID es público, el secret no.
META_APP_ID=""
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_GRAPH_API_VERSION="v26.0"
NEXT_PUBLIC_META_GRAPH_API_VERSION="v26.0"
# Genera una clave independiente de 32 bytes con: openssl rand -hex 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=""
# Verificación y firma del webhook configurado en Meta.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Mercado Pago (Checkout Pro). La comisión se suma al precio y la paga el socio.
MERCADOPAGO_ACCESS_TOKEN=""
# Marketplace de Academia: crea la app OAuth de Lyra en Mercado Pago y habilita PKCE S256.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
ACADEMY_MP_REDIRECT_URI="https://lyyra.vercel.app/api/academy/mercadopago/callback"
ACADEMY_MARKETPLACE_ENABLED="false"
# Genera una clave independiente de 32 bytes con: openssl rand -hex 32
ACADEMY_MP_TOKEN_ENCRYPTION_KEY=""
# Opcionales: moneda de la cuenta, tipo de cambio fijo y tarifa
MP_CURRENCY="MXN"
MP_USD_RATE=""
MP_FEE_RATE="0.0349"
MP_FEE_FIXED="4"
MP_FEE_TAX="0.16"

# Los cron de comisiones y de tareas de Vega exigen Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""
