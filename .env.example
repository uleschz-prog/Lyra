# PostgreSQL: Vercel Postgres o Supabase (cadena con pooling).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lyra?schema=public"

# Firma de la cookie de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-string-of-32-characters"

# Origen público de los enlaces de referido. Si se omite, se usa el dominio actual.
NEXT_PUBLIC_APP_URL="https://lyyra.vercel.app"

# Modo discusión del builder y notebook. Usa una de las dos claves.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Voz del notebook y del estudio creativo. https://elevenlabs.io
ELEVENLABS_API_KEY=""

# Video promocional. Usa una u otra clave según el proveedor del estudio.
HEYGEN_API_KEY=""
RUNWAY_API_KEY=""

# Búsqueda de tendencias. https://dashboard.exa.ai
EXA_API_KEY=""

# Registro con Google, GitHub o Apple. Cada una es opcional.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Proyecto Lira en Composio. La clave se crea en Claves API y no se pega en el navegador.
COMPOSIO_API_KEY=""

# Opcional. Si se omite, LYRA usa el primer número de la cuenta de WhatsApp conectada.
WHATSAPP_PHONE_NUMBER_ID=""

# Secreto compartido de los cron. Vercel lo manda como `Authorization: Bearer`.
CRON_SECRET=""

# Vega · presupuesto de LLM, aparte del libro de créditos. Fracción del precio mensual del plan.
# Founder usa la mensualidad de $29. Corporate no tiene mensualidad: la base es el precio del plan.
# Vacío = 0.05. Un override por usuario vive en VegaProfile.budgetRatioOverride.
LLM_BUDGET_RATIO="0.05"
# Cadenas de OpenRouter, de primero a último. Los IDs cambian y no van en el código.
# Ejemplos de familia: Grok, Llama 3.1 70B y Claude 3.5 Sonnet.
LLM_CHAIN_CHEAP=""
LLM_CHAIN_BALANCED=""
LLM_CHAIN_PREMIUM=""
LLM_RETRIES_PER_MODEL="2"
LLM_TIMEOUT_MS="20000"

# Upstash Redis REST. Ahí vive el gasto mensual de LLM.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# X API v2. Una sola ingesta compartida usa este token. No se consulta por usuario.
X_BEARER_TOKEN=""
X_API_BASE="https://api.x.com/2"
VEGA_INGEST_MAX_QUERIES="8"
VEGA_INGEST_INTERVAL_MS="300000"

# Qdrant. Si se omite, el histórico del agente queda apagado.
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="vega_posts"

# Crisis: índice = posts negativos / posts de la ventana. El modelo solo entra después del umbral.
VEGA_CRISIS_THRESHOLD="0.6"
VEGA_CRISIS_WINDOW_MINUTES="60"
VEGA_CRISIS_MIN_POSTS="5"

# Correo de reportes programados al propio usuario. Sin clave, el reporte queda en el dashboard.
RESEND_API_KEY=""
VEGA_REPORT_FROM=""

# Mercado Pago (Checkout Pro). La comisión se suma al precio y la paga el socio.
MERCADOPAGO_ACCESS_TOKEN=""
# Opcionales: moneda de la cuenta, tipo de cambio fijo y tarifa
MP_CURRENCY="MXN"
MP_USD_RATE=""
MP_FEE_RATE="0.0349"
MP_FEE_FIXED="4"
MP_FEE_TAX="0.16"
