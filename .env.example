# PostgreSQL: Vercel Postgres o Supabase (cadena con pooling).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lyra?schema=public"

# Firma de la cookie de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-string-of-32-characters"

# Origen público de los enlaces de referido. Si se omite, se usa el dominio actual.
NEXT_PUBLIC_APP_URL="https://lyyra.vercel.app"

# Modo discusión del builder y notebook. Usa una de las dos claves.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Modelo de chat de Vega y el notebook. Vacío usa gemini-2.5-flash.
GEMINI_MODEL=""
# Vacío prueba gemini-3.1-flash-image y después gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=""
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Video de anuncios. Vacío usa google/veo-3.1 (4K u 1080p, con audio, clips de 8 s).
OPENROUTER_VIDEO_MODEL=""

# Voz del notebook y del estudio creativo. https://elevenlabs.io
ELEVENLABS_API_KEY=""

# Video promocional. Usa una u otra clave según el proveedor del estudio.
HEYGEN_API_KEY=""
RUNWAY_API_KEY=""
# La misma clave, con el nombre que usa Runway. Si las dos existen, gana esta.
RUNWAYML_API_SECRET=""
RUNWAY_DEFAULT_MODEL=""

# Búsqueda de tendencias. https://dashboard.exa.ai
EXA_API_KEY=""

# Registro con Google, GitHub o Apple. Cada una es opcional.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Proyecto Lira en Composio. La clave se crea en Claves API y no se pega en el navegador.
COMPOSIO_API_KEY=""

# Opcional. Si se omite, LYRA usa el primer número de la cuenta de WhatsApp conectada.
WHATSAPP_PHONE_NUMBER_ID=""
# Token de la Cloud API de Meta para enviar desde el número del socio.
WHATSAPP_ACCESS_TOKEN=""
# Verificación (GET) y firma (POST) del webhook configurado en Meta. Sin valores reales.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Opcionales del agente de WhatsApp.
WHATSAPP_OWNER_PHONE=""
WHATSAPP_REMINDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="es_MX"
WHATSAPP_MAX_AUTO_FOLLOWUPS=""
WHATSAPP_FOLLOWUP_FAST=""

# Mercado Pago (Checkout Pro). La comisión se suma al precio y la paga el socio.
MERCADOPAGO_ACCESS_TOKEN=""
# Opcionales: moneda de la cuenta, tipo de cambio fijo y tarifa
MP_CURRENCY="MXN"
MP_USD_RATE=""
MP_FEE_RATE="0.0349"
MP_FEE_FIXED="4"
MP_FEE_TAX="0.16"

# Polygon mainnet, para el contrato de membresía. No pongas secretos aquí.
POLYGON_MAINNET_RPC_URL="https://polygon-bor-rpc.publicnode.com"
PRIVATE_KEY=""
# Etherscan API v2, para verificar el contrato de membresía.
ETHERSCAN_API_KEY=""
# Contrato de membresía en Polygon. Vacío deja el botón de USDC en espera y Mercado Pago sigue activo.
NEXT_PUBLIC_LYRA_MEMBERSHIP_ADDRESS=""
# USDC nativo de Polygon: 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
NEXT_PUBLIC_POLYGON_RPC_URL=""
# Opcional. Verificación de transferencias USDT TRC20 en la aprobación admin.
TRONGRID_API_KEY=""
# Opcional. Si no se usa el panel admin, wallet USDT TRC20 de la empresa.
COMPANY_USDT_TRC20=""

# Los cron de comisiones y de tareas de Vega exigen Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""
