# PostgreSQL: Vercel Postgres o Supabase (cadena con pooling).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lyra?schema=public"

# Firma de la cookie de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-string-of-32-characters"

# Origen público de los enlaces de referido. Si se omite, se usa el dominio actual.
NEXT_PUBLIC_APP_URL="https://lyyra.vercel.app"

# Vercel AI Gateway (modelos más fuertes con respaldo entre proveedores). Si no se define, Vega sigue
# con Gemini directo (GEMINI_API_KEY) y el respaldo OpenRouter, igual que antes.
# Clave: Vercel → AI Gateway → API Keys (https://vercel.com/docs/ai-gateway/authentication-and-byok).
AI_GATEWAY_API_KEY=
# "oidc" usa el token OIDC del proyecto en Vercel en lugar de la clave; "off" apaga el Gateway.
VEGA_AI_GATEWAY=
# Nivel «fuerte» (generador, apps, juegos, tareas con varias herramientas) y «rápido» (chat sencillo,
# resúmenes). Un id o varios separados por comas (ids de https://ai-gateway.vercel.sh/v1/models).
# Vacíos usan anthropic/claude-sonnet-5.5 → spacexai/grok-4.7 → openai/gpt-5.6-terra y
# anthropic/claude-haiku-5.5 → openai/gpt-5.6-luna → google/gemini-3.5-flash-lite.
VEGA_MODEL_FUERTE=
VEGA_MODEL_RAPIDO=
# Respaldos por nivel (reemplazan los de arriba) y respaldos extra para ambos niveles.
VEGA_MODEL_FUERTE_FALLBACKS=
VEGA_MODEL_RAPIDO_FALLBACKS=
VEGA_MODEL_FALLBACKS=
# Nivel del chat: auto (rápido solo para mensajes cortos y sencillos), fuerte o rapido.
VEGA_CHAT_TIER=
# Nivel del generador de sitios, apps y juegos: fuerte (por defecto) o rapido (si el fuerte no cabe en el tiempo).
VEGA_BUILDER_TIER=

# Modo discusión del builder y notebook. Usa una de las dos claves.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Modelo de chat de Vega y el notebook. Vacío usa gemini-2.5-flash.
GEMINI_MODEL=""
# https://openrouter.ai/keys
# También activa el respaldo de Vega: si Gemini falla, Vega responde con OpenRouter.
OPENROUTER_API_KEY=""
# Modelo de respaldo de Vega en OpenRouter. Vacío usa google/gemini-2.5-flash.
OPENROUTER_MODEL=""
# Pon "off" para apagar el respaldo de Vega aunque exista OPENROUTER_API_KEY.
VEGA_FALLBACK=""
# Llamadas al modelo por turno de Vega (1-30). Vacío usa 12.
VEGA_MAX_STEPS=""
# Tiempo máximo de un turno de Vega en ms (10000-55000). Vacío usa 45000.
VEGA_TIME_BUDGET_MS=""
# Envíos (correos, WhatsApp, publicaciones, cobros) que Vega puede ejecutar por socio por hora (1-200). Vacío usa 20.
VEGA_SENDS_PER_HOUR=""
# Rutinas activas o en pausa por socio (1-100). Vacío usa 20.
VEGA_MAX_ROUTINES=""
# Ejecuciones de rutinas en segundo plano por socio por hora (1-60); las demás se omiten. Vacío usa 8.
VEGA_ROUTINE_RUNS_PER_HOUR=""
# Turnos de rutinas que el despachador corre en paralelo por invocación (1-5). Vacío usa 3.
VEGA_ROUTINE_CONCURRENCY=""
# Tope mensual de costo de IA de Vega por socio (mes calendario de Ciudad de México).
# "off" lo apaga. Los administradores no tienen tope.
VEGA_COST_CAP=""
# Porcentaje de la recarga mínima del plan (0.1-100). Vacío usa 5: Inicio $0.95, Negocio $2.45, Pro $4.95 USD.
VEGA_COST_CAP_PCT=""
# Montos fijos en USD por plan (opcionales; ganan al porcentaje).
VEGA_COST_CAP_INICIO_USD=""
VEGA_COST_CAP_NEGOCIO_USD=""
VEGA_COST_CAP_PRO_USD=""
# Porcentaje del tope en que el medidor avisa (1-99). Vacío usa 80.
VEGA_COST_WARN_PCT=""
# "off" para no cambiar a un modelo más barato cerca del tope.
VEGA_COST_DEGRADE=""
# Porcentaje del tope desde el que se usa el modelo barato (1-100). Vacío usa 80.
VEGA_COST_DEGRADE_PCT=""
# Modelo barato. Vacío usa gemini-2.5-flash-lite (Gemini) y google/gemini-2.5-flash-lite (OpenRouter).
VEGA_COST_DEGRADE_MODEL=""
VEGA_COST_DEGRADE_OPENROUTER_MODEL=""
# Precios propios en USD por millón de tokens, JSON: {"gemini-3.5-flash-lite":{"input":0.3,"output":2.5}}.
VEGA_MODEL_PRICES=""
# Precio "entrada,salida" para modelos sin precio conocido. Vacío usa 1.5,7.5 (alto a propósito).
VEGA_COST_DEFAULT_PRICE=""

# Inteligencia de mercado en X (Fase 8). Token «Bearer» de app de X API v2 (solo lectura, de la plataforma).
# Sin token, las herramientas de X responden con un aviso y Vega sigue funcionando. Nunca lo subas al repo.
X_BEARER_TOKEN=""
# Base de la API. Vacío usa https://api.x.com/2
X_API_BASE=""
# "off" apaga las herramientas y monitores de X.
VEGA_X=""
# Posts de X que cada socio puede leer al día (CDMX; un conteo de volumen cuenta como 1).
# Vacíos usan Inicio 50, Negocio 150, Pro 400 y administradores 1000.
VEGA_X_DAILY_POSTS_INICIO=""
VEGA_X_DAILY_POSTS_NEGOCIO=""
VEGA_X_DAILY_POSTS_PRO=""
VEGA_X_DAILY_POSTS_ADMIN=""
# Tope diario de posts para toda la plataforma (protege el saldo de X). Vacío usa 3000 (~$15-30 USD al día).
VEGA_X_GLOBAL_DAILY_POSTS=""
# Monitores de X por socio. Vacíos usan Inicio 1, Negocio 3, Pro 5.
VEGA_X_MONITORS_INICIO=""
VEGA_X_MONITORS_NEGOCIO=""
VEGA_X_MONITORS_PRO=""
# Minutos mínimos entre sondeos de un monitor (15-1440). Vacío usa 60.
VEGA_X_MONITOR_MIN_MINUTES=""
# Posts máximos por sondeo de monitor (10-100). Vacío usa 25.
VEGA_X_MONITOR_MAX_POSTS=""
# Minutos que se reutiliza una respuesta de X entre socios (0 = sin caché). Vacío usa 15.
VEGA_X_CACHE_MINUTES=""
# "off" para que el gasto en X no cuente contra el tope mensual de costo de la Fase 7.
VEGA_X_COUNT_IN_COST_CAP=""
# Precios de X API en USD (revisados el 2026-11-12). Vacíos usan post 0.005, usuario 0.01 y conteo 0.005.
VEGA_X_PRICE_POST=""
VEGA_X_PRICE_USER=""
VEGA_X_PRICE_COUNTS=""
# Alerta de crisis: proporción negativa (0.05-1, vacío 0.5), posts mínimos por sondeo (vacío 5),
# subida sobre la línea base que también alerta (vacío 0.25) y horas sin repetir la alerta (vacío 6).
VEGA_CRISIS_THRESHOLD=""
VEGA_CRISIS_MIN_POSTS=""
VEGA_CRISIS_SPIKE=""
VEGA_CRISIS_COOLDOWN_HOURS=""
# Vercel Blob privado: archivos y vistas previas del generador de sitios y apps, e imágenes de Vega.
BLOB_READ_WRITE_TOKEN=""

# Imágenes de Vega (generar_imagen: flyers y posts con texto exacto en español). Se activa sola con
# AI_GATEWAY_API_KEY + BLOB_READ_WRITE_TOKEN. Proveedor: "gateway" (vacío), "openai" (usa OPENAI_API_KEY
# directo) u "off". Modelo: id del Gateway (vacío = openai/gpt-image-2; también google/gemini-3.1-flash-image,
# bfl/flux-3-image…). Calidad de GPT Image: low | medium (vacío) | high.
VEGA_IMAGE_PROVIDER=""
VEGA_IMAGE_MODEL=""
VEGA_IMAGE_QUALITY=""
# Créditos por imagen (vacío 2; se devuelven si falla), tope global de gasto del proveedor por mes en USD
# (vacío 25), límites por socio (vacío 6 por hora y 20 por día) y tiempo máximo por imagen en ms (vacío 50000).
VEGA_IMAGE_PRICE_CREDITS=""
VEGA_IMAGE_MONTHLY_CAP_USD=""
VEGA_IMAGE_PER_HOUR=""
VEGA_IMAGE_PER_DAY=""
VEGA_IMAGE_TIMEOUT_MS=""
# "on" lee el texto de la imagen con el modelo rápido y avisa si falta una línea (≈ centavos por imagen).
VEGA_IMAGE_TEXT_CHECK=""
# Costo estimado en USD de modelos sin tabla de precios (para el tope mensual; vacío 0.25).
VEGA_IMAGE_EST_COST_USD=""

# Búsqueda de tendencias. https://dashboard.exa.ai
EXA_API_KEY=""

# Registro con Google, GitHub o Apple. Cada una es opcional.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Proyecto Lira en Composio. La clave se crea en Claves API y no se pega en el navegador.
COMPOSIO_API_KEY=""

# Opcional. Si se omite, LYRA usa el primer número de la cuenta de WhatsApp conectada.
WHATSAPP_PHONE_NUMBER_ID=""
# Token de la Cloud API de Meta para enviar desde el número del socio.
WHATSAPP_ACCESS_TOKEN=""
# Opcionales del agente de WhatsApp.
WHATSAPP_REMINDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="es_MX"
WHATSAPP_MAX_AUTO_FOLLOWUPS=""
WHATSAPP_FOLLOWUP_FAST=""

# WhatsApp Business Platform (Meta Embedded Signup). El app ID es público, el secret no.
META_APP_ID=""
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_GRAPH_API_VERSION="v26.0"
NEXT_PUBLIC_META_GRAPH_API_VERSION="v26.0"
# Genera una clave independiente de 32 bytes con: openssl rand -hex 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=""
# Verificación y firma del webhook configurado en Meta.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Mercado Pago de la empresa (Checkout Pro): paquetes y recargas de créditos.
MERCADOPAGO_ACCESS_TOKEN=""
# Opcionales: moneda de la cuenta, tipo de cambio fijo y tarifa
MP_CURRENCY="MXN"
MP_USD_RATE=""
MP_FEE_RATE="0.0349"
MP_FEE_FIXED="4"
MP_FEE_TAX="0.16"

# Opcional. Verificación de transferencias USDT TRC20 en la aprobación admin.
TRONGRID_API_KEY=""
# Opcional. Si no se usa el panel admin, wallet USDT TRC20 de la empresa.
COMPANY_USDT_TRC20=""

# Los cron de comisiones y de rutinas de Vega exigen Authorization: Bearer <CRON_SECRET>.
# Para horas exactas en Hobby, un pinger externo llama /api/vega/routines/dispatch cada 5 min
# con ese mismo header (ver README, «Rutinas de Vega»).
CRON_SECRET=""
