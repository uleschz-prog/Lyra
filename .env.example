# PostgreSQL: Vercel Postgres o Supabase (cadena con pooling).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lyra?schema=public"

# Firma de la cookie de sesión. Genera una con: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-string-of-32-characters"

# Origen público de los enlaces de referido. Si se omite, se usa el dominio actual.
NEXT_PUBLIC_APP_URL="https://lyyra.vercel.app"

# Modo discusión del builder y notebook. Usa una de las dos claves.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Modelo de chat de Vega y el notebook. Vacío usa gemini-2.5-flash.
GEMINI_MODEL=""
# https://openrouter.ai/keys
# También activa el respaldo de Vega: si Gemini falla, Vega responde con OpenRouter.
OPENROUTER_API_KEY=""
# Modelo de respaldo de Vega en OpenRouter. Vacío usa google/gemini-2.5-flash.
OPENROUTER_MODEL=""
# Pon "off" para apagar el respaldo de Vega aunque exista OPENROUTER_API_KEY.
VEGA_FALLBACK=""
# Llamadas al modelo por turno de Vega (1-30). Vacío usa 12.
VEGA_MAX_STEPS=""
# Tiempo máximo de un turno de Vega en ms (10000-55000). Vacío usa 45000.
VEGA_TIME_BUDGET_MS=""
# Envíos (correos, WhatsApp, publicaciones, cobros) que Vega puede ejecutar por socio por hora (1-200). Vacío usa 20.
VEGA_SENDS_PER_HOUR=""
# Rutinas activas o en pausa por socio (1-100). Vacío usa 20.
VEGA_MAX_ROUTINES=""
# Ejecuciones de rutinas en segundo plano por socio por hora (1-60); las demás se omiten. Vacío usa 8.
VEGA_ROUTINE_RUNS_PER_HOUR=""
# Turnos de rutinas que el despachador corre en paralelo por invocación (1-5). Vacío usa 3.
VEGA_ROUTINE_CONCURRENCY=""
# Tope mensual de costo de IA de Vega por socio (mes calendario de Ciudad de México).
# "off" lo apaga. Los administradores no tienen tope.
VEGA_COST_CAP=""
# Porcentaje de la recarga mínima del plan (0.1-100). Vacío usa 5: Inicio $0.95, Negocio $2.45, Pro $4.95 USD.
VEGA_COST_CAP_PCT=""
# Montos fijos en USD por plan (opcionales; ganan al porcentaje).
VEGA_COST_CAP_INICIO_USD=""
VEGA_COST_CAP_NEGOCIO_USD=""
VEGA_COST_CAP_PRO_USD=""
# Porcentaje del tope en que el medidor avisa (1-99). Vacío usa 80.
VEGA_COST_WARN_PCT=""
# "off" para no cambiar a un modelo más barato cerca del tope.
VEGA_COST_DEGRADE=""
# Porcentaje del tope desde el que se usa el modelo barato (1-100). Vacío usa 80.
VEGA_COST_DEGRADE_PCT=""
# Modelo barato. Vacío usa gemini-2.5-flash-lite (Gemini) y google/gemini-2.5-flash-lite (OpenRouter).
VEGA_COST_DEGRADE_MODEL=""
VEGA_COST_DEGRADE_OPENROUTER_MODEL=""
# Precios propios en USD por millón de tokens, JSON: {"gemini-3.5-flash-lite":{"input":0.3,"output":2.5}}.
VEGA_MODEL_PRICES=""
# Precio "entrada,salida" para modelos sin precio conocido. Vacío usa 1.5,7.5 (alto a propósito).
VEGA_COST_DEFAULT_PRICE=""
# Modelo de video en OpenRouter. Vacío usa x-ai/grok-imagine-video-1.5-lite a 480p.
OPENROUTER_VIDEO_MODEL=""
# Vercel Blob para guardar los videos finales de forma privada.
BLOB_READ_WRITE_TOKEN=""

# Voz del notebook y del estudio creativo. https://elevenlabs.io
ELEVENLABS_API_KEY=""

# Generación de imágenes y videos del estudio. Crea estas credenciales en https://console.higgsfield.ai
HF_KEY_ID=""
HF_KEY_SECRET=""

# Video promocional. Usa una u otra clave según el proveedor del estudio.
HEYGEN_API_KEY=""
RUNWAY_API_KEY=""
# La misma clave, con el nombre que usa Runway. Si las dos existen, gana esta.
RUNWAYML_API_SECRET=""
RUNWAY_DEFAULT_MODEL=""

# Búsqueda de tendencias. https://dashboard.exa.ai
EXA_API_KEY=""

# Registro con Google, GitHub o Apple. Cada una es opcional.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Proyecto Lira en Composio. La clave se crea en Claves API y no se pega en el navegador.
COMPOSIO_API_KEY=""

# Opcional. Si se omite, LYRA usa el primer número de la cuenta de WhatsApp conectada.
WHATSAPP_PHONE_NUMBER_ID=""
# Token de la Cloud API de Meta para enviar desde el número del socio.
WHATSAPP_ACCESS_TOKEN=""
# Opcionales del agente de WhatsApp.
WHATSAPP_REMINDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="es_MX"
WHATSAPP_MAX_AUTO_FOLLOWUPS=""
WHATSAPP_FOLLOWUP_FAST=""

# WhatsApp Business Platform (Meta Embedded Signup). El app ID es público, el secret no.
META_APP_ID=""
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_GRAPH_API_VERSION="v26.0"
NEXT_PUBLIC_META_GRAPH_API_VERSION="v26.0"
# Genera una clave independiente de 32 bytes con: openssl rand -hex 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=""
# Verificación y firma del webhook configurado en Meta.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Mercado Pago de la empresa (Checkout Pro); Academia cobra directamente en esta cuenta.
MERCADOPAGO_ACCESS_TOKEN=""
# Habilita los pagos de cursos en Academia después de configurar la cuenta de Lyra.
ACADEMY_PAYMENTS_ENABLED="false"
# Compatibilidad con el nombre anterior de la bandera.
ACADEMY_MARKETPLACE_ENABLED="false"
# Opcional/legacy: conexión OAuth de vendedores de la antigua modalidad marketplace.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
ACADEMY_MP_REDIRECT_URI="https://lyyra.vercel.app/api/academy/mercadopago/callback"
# Opcional/legacy: clave de cifrado de tokens de vendedores de la antigua modalidad marketplace.
ACADEMY_MP_TOKEN_ENCRYPTION_KEY=""
# Opcionales: moneda de la cuenta, tipo de cambio fijo y tarifa
MP_CURRENCY="MXN"
MP_USD_RATE=""
MP_FEE_RATE="0.0349"
MP_FEE_FIXED="4"
MP_FEE_TAX="0.16"

# Opcional. Verificación de transferencias USDT TRC20 en la aprobación admin.
TRONGRID_API_KEY=""
# Opcional. Si no se usa el panel admin, wallet USDT TRC20 de la empresa.
COMPANY_USDT_TRC20=""

# Los cron de comisiones y de rutinas de Vega exigen Authorization: Bearer <CRON_SECRET>.
# Para horas exactas en Hobby, un pinger externo llama /api/vega/routines/dispatch cada 5 min
# con ese mismo header (ver README, «Rutinas de Vega»).
CRON_SECRET=""
